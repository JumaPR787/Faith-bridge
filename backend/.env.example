# ─────────────────────────────────────────────────────────────
# FaithBridge backend — variables de entorno (EJEMPLO, SIN SECRETOS)
# Copia a .env y completa. Nunca subas .env al repositorio.
# ─────────────────────────────────────────────────────────────
APP_ENV=development            # development | test | staging | production
PORT=8080
LOG_LEVEL=info

# PostgreSQL (Supabase → Project Settings → Database → Connection string)
DATABASE_URL=postgres://postgres:CAMBIAR@localhost:5432/faithbridge
# Certificado raíz del servidor de base de datos (PEM). Supabase: Database Settings → SSL → Download certificate.
# Con esta variable la conexión usa TLS con verificación estricta.
DATABASE_CA_CERT=

# Supabase Auth
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_JWKS_URL=https://TU-PROYECTO.supabase.co/auth/v1/.well-known/jwks.json
# Solo desarrollo local (en producción usar JWKS; el arranque lo exige):
# SUPABASE_JWT_SECRET=
# Clave de servicio: solo para borrar usuarios de Auth al eliminar cuenta.
SUPABASE_SERVICE_ROLE_KEY=

# Proveedores. "fake" = SIMULADOS (solo desarrollo; bloqueados en staging/producción).
STT_PROVIDER=deepgram          # deepgram | fake
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
DEEPGRAM_KEYTERMS_ENABLED=true    # glosario cristiano en el reconocimiento; costo adicional por minuto (docs/costos.md)

TRANSLATION_PROVIDER=anthropic # anthropic | fake
ANTHROPIC_API_KEY=
# Modelo elegido: Claude Haiku 5.5 (ver docs/costos.md §4). Si lo cambias, actualiza las tarifas COST_*.
TRANSLATION_MODEL=claude-haiku-5-5
TRANSLATION_TIMEOUT_MS=15000
TRANSLATION_CONTEXT_SEGMENTS=3
# Tarifas usadas para ESTIMAR gasto y aplicar el límite diario (USD por millón de tokens).
COST_TRANSLATION_INPUT_USD_PER_MTOK=0.10
COST_TRANSLATION_OUTPUT_USD_PER_MTOK=0.50
COST_STT_USD_PER_MIN=0.0090          # Nova-3 0.0077 + keyterms 0.0013

# RevenueCat (clave SECRETA v1 del proyecto y secreto del webhook)
REVENUECAT_SECRET_API_KEY=
REVENUECAT_WEBHOOK_AUTH=          # cadena aleatoria larga (≥24); configúrala igual en RevenueCat
REVENUECAT_ENTITLEMENT_PERSONAL=personal
REVENUECAT_ENTITLEMENT_CHURCH=church
SANDBOX_PURCHASES=allow           # allow es necesario para revisión de Apple; ver docs/publicacion.md

# Cuotas (segundos)
QUOTA_PERSONAL_SECONDS=18000      # 300 min
QUOTA_TRIAL_SECONDS=7200          # 120 min
QUOTA_CHURCH_SECONDS=36000        # 600 min (fase 2)
TEXT_CHARS_PER_QUOTA_MINUTE=1000
TEXT_MAX_CHARS=20000

# Límites operativos
MAX_SESSION_SECONDS=10800         # 3 h por sesión
SESSION_STARTS_PER_HOUR=12
RESUME_GRACE_SECONDS=60
PAUSE_IDLE_CLOSE_SECONDS=600
# Alertas de presupuesto (Slack/Discord/webhook genérico que acepte {"text": ...})
ALERT_WEBHOOK_URL=
# Modo iglesia (fase 2; además requiere app_config.church_mode_enabled=true)
LISTENER_TOKEN_SECRET=            # cadena aleatoria ≥32 (openssl rand -hex 32); firma los accesos de oyentes
CHURCH_MAX_LISTENERS=30
CHURCH_JOIN_HOURS=6
JOIN_ATTEMPTS_PER_MINUTE=10
# Purga de retención programada dentro del servidor (horas; 0 = desactivada)
PURGE_INTERVAL_HOURS=6
